{
  "permissions": [
    "campaigns.delete",
    "campaigns.write",
    "capture.write",
    "catalog.write",
    "evaluation.write",
    "labels.write",
    "workspace.read"
  ],
  "roles": {
    "viewer": ["workspace.read"],
    "admin": [
      "campaigns.delete",
      "campaigns.write",
      "capture.write",
      "catalog.write",
      "evaluation.write",
      "labels.write",
      "workspace.read"
    ]
